{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiteCowork",
  "version": "0.1.0",
  "identifier": "app.litecowork.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build && pnpm build:daemon-sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LiteCowork",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "A workspace for getting work done",
    "longDescription": "LiteCowork desktop workspace",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "wix": { "upgradeCode": "e78dd61b-7205-5b2c-91f7-3000affa1659" },
      "nsis": { "installMode": "currentUser" }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "section": "utils",
        "files": {
          "/usr/lib/systemd/system/litecoworkd.service": "../../../scripts/packaging/systemd/litecoworkd.service"
        }
      }
    }
  }
}
