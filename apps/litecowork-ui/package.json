{
  "name": "@litecowork/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "check:node": "node scripts/check-node-version.mjs",
    "dev": "pnpm run check:node && vite --host 127.0.0.1",
    "build": "pnpm run check:node && pnpm run api:check && tsc --noEmit && vite build",
    "api:generate": "pnpm run check:node && node scripts/generate-operator-api-types.mjs",
    "api:check": "pnpm run check:node && node scripts/generate-operator-api-types.mjs --check",
    "test": "pnpm run check:node && node --experimental-transform-types --test \"tests/*.test.ts\" \"tests/*.test.mjs\"",
    "test:browser": "pnpm run check:node && node scripts/check-rendered-ui.mjs",
    "preview": "pnpm run check:node && vite preview --host 127.0.0.1",
    "tauri": "pnpm run check:node && tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "openapi-typescript": "7.13.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
